{
  "manifest_version": 3,
  "name": "Tempo Calendar",
  "short_name": "Tempo",
  "version": "1.0.0",
  "description": "Auto-splits tasks into your free time, tracks habits, analyses where time goes, and gamifies your day. Built by Claude AI — free and full-featured, always.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Tempo Calendar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://openidconnect.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "key": "",
  "optional_host_permissions": [
    "https://graph.microsoft.com/*",
    "https://*.icloud.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://horoscope-app-api.vercel.app/*",
    "https://api.apiverve.com/*",
    "https://*/*"
  ]
}
